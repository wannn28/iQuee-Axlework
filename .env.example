# Copy to .env (chmod 600) and replace every "change-me" value. Never commit .env.
# Generate secrets with:  openssl rand -hex 24   /   openssl rand -hex 32
POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-random-characters
API_PORT=8009
API_VERSION=1.0.0
CORS_ORIGINS=https://axlework.iquee.tech
# Public one-click demo account (prefilled on the login page, not a secret)
DEMO_EMAIL=alex.moreno@harborpine.example
DEMO_PASSWORD=demo-password
# Reload the seeded dataset this often (0 disables)
DEMO_RESET_EVERY=24h
LOG_LEVEL=info
